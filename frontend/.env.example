# =============================================================================
# ExecutiveAI — Frontend Environment Variables
# For local dev: copy to .env.local
# For Vercel: set in Project Settings → Environment Variables
# =============================================================================

# Backend API URL — leave blank to use built-in mock data (demo mode)
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket URL for real-time updates
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# App metadata
NEXT_PUBLIC_APP_NAME=ExecutiveAI
NEXT_PUBLIC_APP_VERSION=1.0.0
