# =============================================================================
# ExecutiveAI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_USER=executiveai
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=executiveai_db
DATABASE_URL=postgresql+asyncpg://executiveai:your_secure_password@postgres:5432/executiveai_db

# For synchronous connections (Alembic migrations)
SYNC_DATABASE_URL=postgresql://executiveai:your_secure_password@postgres:5432/executiveai_db

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
SECRET_KEY=your-super-secret-key-change-in-production-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS allowed origins (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000,https://yourdomain.com

# -----------------------------------------------------------------------------
# AI APIs
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Default AI model
AI_MODEL=claude-sonnet-4-6
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.1

# -----------------------------------------------------------------------------
# Frontend (Next.js)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=ExecutiveAI
NEXT_PUBLIC_APP_VERSION=1.0.0

# WebSocket URL
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# -----------------------------------------------------------------------------
# Email (for scheduled reports and notifications)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_TLS=true
EMAILS_FROM_EMAIL=noreply@yourdomain.com
EMAILS_FROM_NAME=ExecutiveAI

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# First superadmin user (created during seeding)
FIRST_SUPERUSER_EMAIL=admin@executiveai.com
FIRST_SUPERUSER_PASSWORD=changeme_immediately

# Default organization
DEFAULT_ORG_NAME=ExecutiveAI Demo

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# -----------------------------------------------------------------------------
# Celery
# -----------------------------------------------------------------------------
CELERY_TASK_ALWAYS_EAGER=false
CELERY_WORKER_CONCURRENCY=4
